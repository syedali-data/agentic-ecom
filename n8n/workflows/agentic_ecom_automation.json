            {
              "id": "check-kill-switch",
              "leftValue": "={{ $json.status }}",
              "rightValue": "STOP",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "kill-switch-check",
      "name": "Kill Switch Check",
      "type": "n8n-nodes-base.if",
